#구글 OAuth Client ID/Secret (구글 클라우드 콘솔에서 발급)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
#카카오 REST API 키 / Client Secret (카카오 디벨로퍼스에서 발급)
KAKAO_CLIENT_ID=3d4417b1729cbb24fb7381b25c126bd6
KAKAO_CLIENT_SECRET=CCRYJAxQZt8K3TRAo3ZgOiFBMkDpDCNr
#네이버 Client ID/Secret (네이버 개발자센터 https://developers.naver.com 에서 발급 후 아래 값을 실제 값으로 교체할 것)

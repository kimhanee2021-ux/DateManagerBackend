#오라클 DB 계정 이름
ORACLE_USERNAME=
#오라클 DB 계정 비밀번호
ORACLE_PASSWORD=
#AWS에서 발급받은 엑세스 키
S3_ACCESS_KEY=
#AWS에서 발급받은 시크릿 키
S3_SECRET_KEY=
#JWT 시크릿 키
JWT_SECRET_KEY=
#구글 OAuth Client ID/Secret (구글 클라우드 콘솔에서 발급)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
#카카오 REST API 키 / Client Secret (카카오 디벨로퍼스에서 발급)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
#네이버 Client ID/Secret (네이버 개발자센터 https://developers.naver.com 에서 발급 후 아래 값을 실제 값으로 교체할 것)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
#KOPIS(공연예술통합전산망) 오픈API 인증키 - 실제 키로 교체 전까지는 PlaceSyncService의 공연 동기화만 안 될 뿐 서버는 정상 기동함
KOPIS_SERVICE_KEY=
#기상청 API 허브 인증키 - 비어있으면 서버는 정상 기동하지만 홈 화면 날씨 조회는 실패함
KMA_AUTH_KEY=
#관리자 페이지(/admin) 접근을 허용할 계정 이메일 - 이 이메일로 로그인한 사람만 관리자로 취급됨
ADMIN_EMAIL=
#토스페이먼츠 시크릿 키 - 구독(정기결제) 기능용. 비어있으면 서버는 뜨지만 결제 관련 API만 실패함 (테스트 연동 시 test_sk_로 시작하는 테스트 키 사용)
TOSS_SECRET_KEY=
#네이버 지역 검색 API(NCP 콘솔 발급, 소셜로그인용 NAVER_CLIENT_ID와는 별개) - 액티비티/문화시설 장소 동기화용
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
#카카오 로컬 API(장소 검색) 키(카카오 디벨로퍼스 발급, 소셜로그인용 KAKAO_CLIENT_ID와는 별개) - 장소 동기화용
KAKAO_REST_API_KEY=
#OpenAI API 키 - AI 챗봇(AiChatService)용. 비어있으면 챗봇 호출만 401/429로 실패함
OPENAI_API_KEY=
#서울올림픽기념국민체육진흥공단 체육진흥투표권(스포츠toto,프로토) 발매대상 경기정보 API 인증키(data.go.kr) - SportsSyncService용.
#주의: data.go.kr "일반 인증키(Encoding)"가 아니라 %2F/%2B/%3D 등을 실제 문자(/,+,=)로 디코딩한 값을 넣을 것
#(코드에서 URLEncoder로 한 번만 인코딩해서 보내는 구조라, 이미 인코딩된 값을 넣으면 이중 인코딩되어 인증 실패함)
SPORTS_API_SERVICE_KEY=
#숙박업 CSV 파일 경로 - 값을 안 넣으면 기본값(data/lodging_wgs84.csv)을 쓴다. 이 CSV는 저장소에 커밋되지 않으므로
#(.gitignore의 /data/) 직접 재동기화할 게 아니라면 비워둬도 무방함 - place 데이터는 덤프 파일로 공유받는 게 기본 경로.
LODGING_CSV_PATH=
#비밀번호 찾기(재설정) 메일 발송용 계정 - 발송 전용으로 쓰는 지메일 주소와 앱 비밀번호(일반 로그인 비밀번호 아님,
#2단계 인증 켠 뒤 myaccount.google.com/apppasswords에서 발급). 팀 내 공유 키는 담당자에게 별도로 전달받을 것.
MAIL_USERNAME=
MAIL_PASSWORD=
#한국수출입은행 환율 API 인증키(data.go.kr 또는 koreaexim.go.kr 발급) - 스마트 자금 플래너(financialPlanner) 환율 브리핑용, 아직 백엔드 미구현
EXIM_EXCHANGE_API_KEY=
#금융감독원 금융상품 통합비교공시(finlife) API 인증키 - 스마트 자금 플래너 예·적금 추천용, 아직 백엔드 미구현
FSS_FINLIFE_API_KEY=

